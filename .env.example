# Configuration for the AI-Agent. Copy to `.env` and adjust.
# All values are optional; sensible defaults are applied in src/config.js.

# --- Model backend ---
# Provider to use. Any of: "local" (OpenAI-compatible local server) or "cloud".
MODEL_PROVIDER=local

# Endpoint for the local model server. Works with llama.cpp (server),
# Ollama (OPENAI_COMPATIBLE endpoint), LM Studio, vLLM, etc.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_MODEL_NAME=qwen2.5-coder:3b
LOCAL_MODEL_API_KEY=local

# Cloud fallback (OpenAI-compatible). Only used when MODEL_PROVIDER=cloud
# or when a local request fails and CLOUD_FALLBACK=true.
CLOUD_MODEL_BASE_URL=https://openrouter.ai/api/v1
CLOUD_MODEL_NAME=openrouter/auto
CLOUD_MODEL_API_KEY=
CLOUD_FALLBACK=false

# --- Generation ---
MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=2048
MODEL_TIMEOUT_MS=120000

# --- Agent loop ---
AGENT_MAX_STEPS=30
AGENT_MAX_RETRIES=3

# --- Context ---
REPO_MAP_MAX_TOKENS=1024
SKILL_TOP_K=4

# --- Memory ---
MEMORY_DIR=.agent-memory

# --- Safety ---
# Comma-separated list of glob patterns that are never writable by the agent.
PROTECTED_PATHS=.env,*.pem,*.key,.git/**,node_modules/**
# Commands matching these substrings are blocked from execution.
BLOCKED_COMMANDS=rm -rf /,sudo,shutdown,reboot,mkfs

# --- Logs ---
LOG_LEVEL=info
