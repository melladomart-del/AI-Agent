# Configuration for the AI-Agent. Copy to `.env` and adjust.
# All values are optional; sensible defaults are applied in src/config.js.

# --- Model backend ---
# Provider to use. Any of: "local" (OpenAI-compatible local server) or "cloud".
MODEL_PROVIDER=local

# Endpoint for the local model server. Works with llama.cpp (llama-server /
# llama-cpp-python), Ollama (OpenAI-compatible endpoint), LM Studio, vLLM, etc.
# The agent does NOT depend on any specific backend — any OpenAI-compatible
# /v1/chat/completions endpoint works. Configure via env, point at your server.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:8080/v1
# Validated small coding model: Qwen2.5-Coder-1.5B-Instruct (Q4_K_M GGUF, ~1.1GB)
# runs end-to-end on modest hardware. Ollama users can use qwen2.5-coder:3b.
LOCAL_MODEL_NAME=qwen2.5-coder:1.5b
LOCAL_MODEL_API_KEY=local

# Cloud fallback (OpenAI-compatible). Only used when MODEL_PROVIDER=cloud
# or when a local request fails and CLOUD_FALLBACK=true.
CLOUD_MODEL_BASE_URL=https://openrouter.ai/api/v1
CLOUD_MODEL_NAME=openrouter/auto
CLOUD_MODEL_API_KEY=
CLOUD_FALLBACK=false

# --- Generation ---
MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=2048
MODEL_TIMEOUT_MS=120000
# Retries with exponential backoff for transient local-server errors.
PROVIDER_RETRIES=1
PROVIDER_RETRY_BACKOFF_MS=750
# Truncate tool observations (file dumps, command output) to keep context small
# for limited-context local models. Set to 0 to disable truncation.
OBSERVATION_MAX_CHARS=6000

# --- Agent loop ---
AGENT_MAX_STEPS=30
AGENT_MAX_RETRIES=3

# --- Context ---
REPO_MAP_MAX_TOKENS=1024
SKILL_TOP_K=4

# --- Memory ---
MEMORY_DIR=.agent-memory

# --- Safety ---
# Comma-separated list of glob patterns that are never writable by the agent.
PROTECTED_PATHS=.env,*.pem,*.key,.git/**,node_modules/**
# Commands matching these substrings are blocked from execution.
BLOCKED_COMMANDS=rm -rf /,sudo,shutdown,reboot,mkfs

# --- Logs ---
LOG_LEVEL=info
